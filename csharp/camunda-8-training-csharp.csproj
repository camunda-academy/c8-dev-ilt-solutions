<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Camunda.Training.CSharp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- New Camunda C# SDK (technical preview until 8.10). Replaces zb-client. -->
    <PackageReference Include="Camunda.Orchestration.Sdk" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
